# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO VERCEL (Cài đặt trên Vercel Dashboard > Settings > Environment Variables)
# ==============================================================================

# 1. URL của Backend MathType OLE (Frontend cần biến này khi build)
VITE_MATHTYPE_SERVER_URL=http://localhost:8000

# 2. Tên trung tâm / hệ thống (tùy chọn)
VITE_CENTER_NAME=EduCenter

# 3. Domain web chính thức của bạn trên Vercel (dùng để tạo link công khai cho phụ huynh)
PUBLIC_APP_URL=https://cham-bai-tu-luan-chi.vercel.app

# 4. Thông tin Firebase Admin Service Account (Dán nguyên nội dung file JSON tải từ Firebase Console)
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"cham-bai-tu-luan-59d0e",...}

# 5. Kết nối Google Apps Script (Lưu ảnh Google Drive & chấm bài bằng Gemini)
# URL Web App deploy dạng /exec từ Apps Script
ESSAY_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx.../exec
# Chuỗi bí mật tự đặt để bảo vệ gọi giữa Vercel và Apps Script (khớp với API_SECRET trong Apps Script)
ESSAY_APPS_SCRIPT_SECRET=chuoi_bi_mat_tu_dat_123456

# 6. Cấu hình gửi Zalo (Tùy chọn, chỉ cần khi dùng tính năng gửi tin nhắn Zalo)
ZALO_BACKEND_URL=
ZALO_BACKEND_API_KEY=


# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO GOOGLE APPS SCRIPT (Cài tại Apps Script > Project Settings > Script Properties)
# ==============================================================================
# API_SECRET=chuoi_bi_mat_tu_dat_123456
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash
# DRIVE_FOLDER_ID= (tùy chọn, nếu để trống Apps Script sẽ tự tạo thư mục EduCenter Essay Images)
